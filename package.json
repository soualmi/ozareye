{
  "name": "ozareye",
  "version": "0.1.0",
  "private": true,
  "description": "OzarEye — self-hosted, multi-country wildfire thermal-anomaly alert tool (NASA FIRMS satellite detection, wind-aware village exposure, Telegram alerts).",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test:wind": "tsx --test lib/wind.test.ts",
    "test:labels": "tsx --test lib/labels.test.ts",
    "test:wilaya": "tsx --test lib/wilaya.test.ts",
    "test:clustering": "tsx --test lib/clustering.test.ts",
    "test:config": "tsx --test lib/config.test.ts",
    "test:fetch-timeout": "tsx --test lib/fetch-timeout.test.ts",
    "test:landuse": "tsx --test lib/landuse.test.ts",
    "test:dashboard-view": "tsx --test lib/dashboard-view.test.ts",
    "test:live-window": "tsx --test lib/live-window.test.ts",
    "test:satellite-names": "tsx --test lib/satellite-names.test.ts",
    "test:replay": "tsx --test lib/replay.test.ts",
    "test:replay-meteosat": "tsx --test lib/replay-meteosat.test.ts",
    "test:place-name": "tsx --test lib/place-name.test.ts",
    "test:source-health": "tsx --test lib/source-health.test.ts",
    "test:meteosat": "tsx --test lib/meteosat.test.ts",
    "test:slstr": "tsx --test lib/slstr.test.ts",
    "test:early-detection": "tsx --test lib/early-detection.test.ts",
    "test:telegram-text": "tsx --test lib/telegram-text.test.ts",
    "test": "tsx --test lib/wind.test.ts lib/labels.test.ts lib/wilaya.test.ts lib/clustering.test.ts lib/config.test.ts lib/fetch-timeout.test.ts lib/landuse.test.ts lib/dashboard-view.test.ts lib/live-window.test.ts lib/place-name.test.ts lib/replay.test.ts lib/satellite-names.test.ts lib/source-health.test.ts lib/meteosat.test.ts lib/slstr.test.ts lib/early-detection.test.ts lib/telegram-text.test.ts lib/replay-meteosat.test.ts",
    "replay": "tsx scripts/replay.ts",
    "replay:metrics": "tsx scripts/replay-metrics.ts",
    "build-industrial-index": "tsx scripts/build-industrial-index.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
